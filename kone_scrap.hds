try:
    from bs4 import Comment
except Exception:
    Comment = None

try:
    from html import escape, unescape
except ImportError:
    from cgi import escape

    def unescape(s):
        return s

try:
    from urllib.parse import urlparse
except ImportError:
    from urlparse import urlparse


class LoginRequired(errors.LoginRequired):
    def __init__(self, *args, **kwargs):
        super(LoginRequired, self).__init__(
            method='browser',
            url='https://kone.gg/account/signin?path=%2F',
        )


KONE_ROOT = 'https://kone.gg'
KONE_API_ROOT = 'https://api.kone.gg'

ACCEPT_COOKIES = [r'(.*\.)?kone\.gg']
URLS = [
    r'regex:https?://(?:www\.)?kone\.gg/s/[^/?#]+/[^/?#]+',
]

MEDIA_TAGS = ('img', 'video', 'audio', 'source')
COMMENT_ID = re.compile(r'^comment-[A-Za-z0-9_-]{22}$')
DROP_TAGS = ('script', 'style', 'svg', 'input', 'textarea', 'select', 'form')
ARCHIVE_AS_MHTML = False
INCLUDE_CATEGORY_IN_TITLE = True
DOWNLOAD_STICKERS = True
STICKER_TIMEOUT = 3.0
STICKER_BUDGET = 8.0
STICKER_MAX_BYTES = 4 * 1024 * 1024
STICKER_TOTAL_BYTES = 16 * 1024 * 1024

CONTENT_TYPE_EXTS = {
    'image/jpeg': '.jpg',
    'image/jpg': '.jpg',
    'image/png': '.png',
    'image/gif': '.gif',
    'image/webp': '.webp',
    'image/bmp': '.bmp',
    'image/avif': '.avif',
    'video/mp4': '.mp4',
    'video/webm': '.webm',
    'video/ogg': '.ogv',
    'audio/mpeg': '.mp3',
    'audio/mp4': '.m4a',
    'audio/ogg': '.ogg',
    'audio/wav': '.wav',
}


def _normalize_space(text):
    if text is None:
        return ''
    return re.sub(r'\s+', ' ', unescape(text)).strip()


def _text(tag):
    if not tag:
        return ''
    return _normalize_space(tag.get_text(' ', strip=True))


def _abs_url(base, value):
    if not value:
        return ''
    value = unescape(value).strip()
    if not value or value.startswith('data:') or value.startswith('blob:'):
        return value
    if value.startswith('//'):
        return 'https:' + value
    return urljoin(base, value)


def _is_downloadable(url):
    return bool(url) and not url.startswith('data:') and not url.startswith('blob:')


def _is_kone_sticker(url):
    try:
        parsed = urlparse(url)
        return (parsed.scheme == 'https' and parsed.hostname == 'api.kone.gg'
                and not parsed.username and not parsed.password
                and parsed.port in (None, 443)
                and re.fullmatch(r'/v1/sticker/image/[A-Za-z0-9_-]+/?', parsed.path) is not None)
    except (ValueError, TypeError):
        return False


def _is_sticker_redirect(url):
    if _is_kone_sticker(url):
        return True
    try:
        parsed = urlparse(url)
        return (parsed.scheme == 'https' and (parsed.hostname or '').endswith('.mittere.io')
                and not parsed.username and not parsed.password
                and parsed.port in (None, 443))
    except (ValueError, TypeError):
        return False


class _StickerSkipped(Exception):
    pass


class _StickerNoRedirect(HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def _sticker_opener():
    # Hitomi changes urllib's default TLS context; keep this client verified.
    context = ssl.create_default_context()
    context.verify_mode = ssl.CERT_REQUIRED
    context.check_hostname = True
    return build_opener(HTTPSHandler(context=context), _StickerNoRedirect())


def _sticker_type(data):
    if data.startswith(b'\x89PNG\r\n\x1a\n'):
        return 'image/png'
    if data.startswith((b'GIF87a', b'GIF89a')):
        return 'image/gif'
    if data.startswith(b'\xff\xd8\xff'):
        return 'image/jpeg'
    if data[:4] == b'RIFF' and data[8:12] == b'WEBP':
        return 'image/webp'
    if data[:2] == b'BM':
        return 'image/bmp'
    if data[4:8] == b'ftyp' and data[8:12] in (b'avif', b'avis'):
        return 'image/avif'
    raise _StickerSkipped('not an image')


def _fetch_sticker(opener, url, deadline, limit):
    if limit <= 0:
        raise _StickerSkipped('article sticker budget reached')
    # Follow at most two API/CDN redirects, with no cookies or retry loop.
    for redirects in range(3):
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise _StickerSkipped('article sticker budget reached')
        request = Request(url, headers={
            'User-Agent': 'Mozilla/5.0',
            'Referer': KONE_ROOT + '/',
            'Origin': KONE_ROOT,
            'Accept': 'image/*',
        })
        try:
            response = opener.open(request, timeout=min(STICKER_TIMEOUT, remaining))
            break
        except HTTPError as exc:
            status = exc.code
            location = exc.headers.get('Location', '')
            exc.close()
            target = _abs_url(url, location)
            if status in (301, 302, 303, 307, 308) and redirects < 2 and _is_sticker_redirect(target):
                url = target
                continue
            raise _StickerSkipped('HTTP {}'.format(status))
    try:
        if response.status != 200:
            raise _StickerSkipped('HTTP {}'.format(response.status))
        ctype = response.headers.get('Content-Type', '').split(';', 1)[0].strip().lower()
        if ctype and not (ctype.startswith('image/') or ctype == 'application/octet-stream'):
            raise _StickerSkipped('non-image response')
        if response.headers.get('Content-Encoding', 'identity').lower() != 'identity':
            raise _StickerSkipped('unexpected content encoding')
        length = response.headers.get('Content-Length')
        expected = int(length) if length is not None else None
        if expected is not None and (expected <= 0 or expected > limit):
            raise _StickerSkipped('invalid image size')
        data = bytearray()
        while True:
            if time.monotonic() >= deadline:
                raise _StickerSkipped('article sticker budget reached')
            # read1 returns available bytes; a slow trickle cannot fill a large read forever.
            chunk = response.read1(min(64 * 1024, limit + 1 - len(data)))
            if not chunk:
                break
            data.extend(chunk)
            if len(data) > limit:
                raise _StickerSkipped('image too large')
        if not data or (expected is not None and len(data) != expected):
            raise _StickerSkipped('incomplete image')
        return _sticker_type(data), bytes(data)
    finally:
        response.close()


def _mark_skipped_stickers(html, skipped):
    soup = Soup(html)
    for tag in list(soup.find_all(MEDIA_TAGS)):
        if tag.get('src') in skipped:
            label = soup.new_tag('span', attrs={'class': 'kone-sticker-skipped'})
            label.string = '[코네콘 저장 생략]'
            tag.replace_with(label)
        elif tag.get('poster') in skipped:
            del tag.attrs['poster']
    # Hitomi's Soup.__str__ returns the original input, not the edited DOM.
    return soup.decode_contents()


def _prepare_stickers(parsed):
    media = parsed.get('media') or []
    if not any(_is_kone_sticker(item['url']) for item in media):
        return parsed
    deadline = time.monotonic() + STICKER_BUDGET
    # A private opener has no shared cookie jar or automatic retry loop.
    opener, skip_reason = None, 'disabled'
    if DOWNLOAD_STICKERS:
        try:
            opener = _sticker_opener()
        except Exception as exc:
            skip_reason = 'client setup failed: ' + type(exc).__name__
    remaining_bytes = STICKER_TOTAL_BYTES
    kept, skipped = [], set()
    for item in media:
        if _is_kone_sticker(item['url']):
            try:
                if opener is None:
                    raise _StickerSkipped(skip_reason)
                ctype, data = _fetch_sticker(
                    opener, item['url'], deadline, min(STICKER_MAX_BYTES, remaining_bytes))
                item['data'] = data
                item['content_type'] = ctype
                item['name'] = os.path.splitext(item['name'])[0] + CONTENT_TYPE_EXTS[ctype]
                remaining_bytes -= len(data)
            except Exception as exc:
                skipped.add(item['url'])
                reason = str(exc) if isinstance(exc, _StickerSkipped) else type(exc).__name__
                downloader.print_('Kone sticker skipped: {} ({})'.format(item['name'], reason))
                continue
        kept.append(item)
    parsed['media'] = kept
    if skipped:
        parsed['content_html'] = _mark_skipped_stickers(parsed.get('content_html') or '', skipped)
        for comment in parsed.get('comments') or []:
            comment['html'] = _mark_skipped_stickers(comment.get('html') or '', skipped)
    return parsed


def _path_ext(url):
    try:
        path = urlparse(url).path
    except Exception:
        path = url.split('?', 1)[0]
    ext = get_ext(path)
    if ext:
        return ext.lower()
    return ''


def _guess_ext(url, tag_name='', content_type=''):
    ext = _path_ext(url)
    if ext:
        return ext

    ctype = (content_type or '').split(';', 1)[0].strip().lower()
    if ctype in CONTENT_TYPE_EXTS:
        return CONTENT_TYPE_EXTS[ctype]

    guessed = mimetypes.guess_extension(ctype) if ctype else None
    if guessed:
        return guessed

    if tag_name == 'video':
        return '.mp4'
    if tag_name == 'audio':
        return '.mp3'
    return '.webp'


def _split_post_url(url):
    parsed = urlparse(url)
    parts = [p for p in parsed.path.split('/') if p]
    if len(parts) < 3 or parts[0] != 's':
        raise ValueError('Not a Kone article URL')
    return parts[1], parts[2]


def _fix_mojibake(html):
    if not isinstance(html, str):
        try:
            html = html.decode('utf-8', 'replace')
        except Exception:
            html = str(html)

    sample = html[:100000]
    if re.search(r'[가-힣]', sample):
        return html

    try:
        fixed = html.encode('latin-1').decode('utf-8')
    except Exception:
        return html

    if re.search(r'[가-힣]', fixed[:100000]):
        return fixed
    return html


def _remove_comments(node):
    if Comment is None:
        return
    for comment in list(node.find_all(string=lambda x: isinstance(x, Comment))):
        comment.extract()


def _class_list(value):
    if not value:
        return []
    if isinstance(value, (list, tuple)):
        values = value
    else:
        values = str(value).split()
    return [str(v) for v in values]


def _has_class(tag, class_name):
    if not tag or getattr(tag, 'attrs', None) is None:
        return False
    return class_name in _class_list(tag.get('class'))


def _has_classes(tag, class_names):
    if not tag or getattr(tag, 'attrs', None) is None:
        return False
    classes = _class_list(tag.get('class'))
    return all(class_name in classes for class_name in class_names)


def _find_class(root, class_name, name=True):
    if not root:
        return None
    for tag in root.find_all(name):
        if _has_class(tag, class_name):
            return tag
    return None


def _find_classes(root, class_names, name=True):
    if not root:
        return None
    for tag in root.find_all(name):
        if _has_classes(tag, class_names):
            return tag
    return None


def _find_all_class(root, class_name, name=True):
    if not root:
        return []
    return [tag for tag in root.find_all(name) if _has_class(tag, class_name)]


def _clean_dom(node, base_url):
    _remove_comments(node)

    for button in list(node.find_all('button')):
        if button.find(MEDIA_TAGS):
            button.unwrap()
        else:
            button.decompose()

    for tag in list(node.find_all(DROP_TAGS)):
        tag.decompose()

    for tag in list(node.find_all(True)):
        name = tag.name.lower()

        for attr in list(tag.attrs):
            attr_l = attr.lower()
            if attr_l.startswith('on'):
                del tag.attrs[attr]
                continue
            if attr_l in ('srcset', 'sizes', 'loading', 'decoding', 'data-state', 'data-slot'):
                del tag.attrs[attr]

        if name == 'a':
            href = _abs_url(base_url, tag.get('href', ''))
            if href.startswith('javascript:'):
                del tag.attrs['href']
            elif href:
                tag['href'] = href
                tag['target'] = '_blank'
                tag['rel'] = 'noopener noreferrer'

        if name in ('img', 'video', 'audio', 'source'):
            # Local file images must not retain the API's CORS fetch requirement.
            tag.attrs.pop('crossorigin', None)
            if tag.get('src'):
                tag['src'] = _abs_url(base_url, tag.get('src'))
            if tag.get('poster'):
                tag['poster'] = _abs_url(base_url, tag.get('poster'))
            if name in ('video', 'audio'):
                tag['controls'] = ''

        if name == 'iframe' and tag.get('src'):
            tag['src'] = _abs_url(base_url, tag.get('src'))

    for tag in list(node.find_all(True)):
        if _has_class(tag, 'absolute') and not tag.find(MEDIA_TAGS):
            tag.decompose()

    for tag in list(node.find_all(['div', 'span'])):
        if tag.name is None:
            continue
        has_media = tag.find(['img', 'video', 'audio', 'iframe', 'br'])
        if not has_media and not tag.get_text(strip=True) and not tag.get('id'):
            tag.decompose()

    return node


def _fragment_html(tag, base_url, selector=None, inner=True):
    if not tag:
        return ''
    soup = Soup(str(tag))
    root = soup
    if selector:
        if selector.startswith('.'):
            root = _find_class(soup, selector[1:]) or soup
        elif selector.startswith('#'):
            root = soup.find(id=selector[1:]) or soup
        else:
            root = soup.find(selector) or soup
    _clean_dom(root, base_url)
    if inner and hasattr(root, 'contents'):
        return ''.join(str(child) for child in root.contents)
    return str(root)


def _add_media(media, seen, base_url, tag, attr, kind=None):
    url = _abs_url(base_url, tag.get(attr))
    if not _is_downloadable(url):
        return
    if url in seen:
        return

    tag_name = kind or tag.name.lower()
    ext = _guess_ext(url, tag_name)
    filename = '{:04d}{}'.format(len(media) + 1, ext)

    seen.add(url)
    media.append({
        'url': url,
        'name': filename,
        'tag': tag_name,
    })


def _extract_media(node, base_url, media, seen):
    if not node:
        return
    for tag in node.find_all(MEDIA_TAGS):
        name = tag.name.lower()
        if tag.get('src'):
            _add_media(media, seen, base_url, tag, 'src', name)
        if name in ('video', 'audio') and tag.get('poster'):
            _add_media(media, seen, base_url, tag, 'poster', 'img')


def _replace_media_urls(html, media):
    if not html:
        return html

    for item in sorted(media or [], key=lambda x: len(x.get('url') or ''), reverse=True):
        url = item.get('url') or ''
        name = item.get('name') or ''
        if not url or not name:
            continue

        html = html.replace(url, name)
        html = html.replace(url.replace('&', '&amp;'), name)
        html = html.replace(escape(url, quote=True), name)

    return html


def _apply_local_media_paths(parsed):
    media = parsed.get('media') or []
    if not parsed.get('mhtml_base'):
        post_id = re.sub(r'[^A-Za-z0-9._-]+', '_', parsed.get('post_id') or 'post')
        parsed['mhtml_base'] = 'https://kone-archive.local/{}/'.format(post_id)

    parsed['content_html'] = _replace_media_urls(parsed.get('content_html') or '', media)

    for comment in parsed.get('comments') or []:
        comment['html'] = _replace_media_urls(comment.get('html') or '', media)

    return parsed


def _first_text_matching(root, pattern):
    if not root:
        return ''
    regex = re.compile(pattern)
    for s in root.find_all(string=regex):
        text = _normalize_space(s)
        if text:
            return text
    return ''


def _find_user_link(root):
    if not root:
        return None
    first = None
    for link in root.find_all('a', href=True):
        href = link.get('href') or ''
        if not (href.startswith('/u/') or href.startswith('https://kone.gg/u/')):
            continue
        if first is None:
            first = link
        if link.find('span') or _text(link):
            return link
    return first


def _parse_comments(soup, base_url, media, seen):
    root = soup.find(id='post-comment')
    if not root:
        return []

    items = _find_all_class(root, 'comment-item')
    current_layout = not items
    if current_layout:
        items = root.find_all('div', id=COMMENT_ID)

    comments = []
    for item in items:
        if current_layout:
            # The body also holds sticker-only comments and moderation notices.
            # Hitomi's plugin globals shadow the builtin next().
            for content in item.find_all('div', class_='max-w-full'):
                if content.find_parent(id=COMMENT_ID) is item:
                    break
            else:
                continue
            header = content.find_previous_sibling('div')
            depth = len(item.find_parents(id=COMMENT_ID))
        else:
            content = _find_class(item, 'whitespace-pre-wrap')
            header = item
            depth = max(0, len(item.find_parents(class_='comment-list')) - 1)
        if not content:
            continue

        _extract_media(content, base_url, media, seen)

        user = ''
        user_url = ''
        user_link = _find_user_link(header)
        if user_link:
            user_url = _abs_url(base_url, user_link.get('href'))
            user_span = user_link.find('span')
            user = _text(user_span) or _text(user_link)

        time_text = ''
        meta = _find_classes(header, ('text-xs', 'text-muted-foreground'))
        if meta:
            time_text = _text(meta)

        comments.append({
            'user': user,
            'user_url': user_url,
            'time': time_text,
            'depth': min(depth, 4),
            'html': _fragment_html(content, base_url, inner=True),
            'text': _text(content),
        })

    return comments


def _find_title(article, soup):
    h1 = article.find('h1') if article else None
    title = _text(h1)
    if title:
        return title

    og_title = soup.find('meta', {'property': 'og:title'})
    if og_title and og_title.get('content'):
        return _normalize_space(og_title.get('content'))

    doc_title = soup.find('title')
    return _text(doc_title) or 'kone'


def _find_category(article, base_url):
    if not article:
        return ''
    for a in article.find_all('a', href=True):
        href = _abs_url(base_url, a.get('href'))
        text = _text(a)
        if 'category=' in href and text:
            return text.strip('[] ')
    return ''


def _find_writer(article):
    if not article:
        return ''
    link = _find_user_link(article)
    if not link:
        return ''
    span = link.find('span')
    return _text(span) or _text(link)


def _find_stats(article):
    text = _text(article)
    stats = []
    for pattern in (r'조회\s*[0-9,]+|\b[0-9,]+\s+views?\b',
                    r'좋아요\s*-?[0-9,]+|(?<!\w)-?[0-9,]+\s+points?\b',
                    r'댓글\s*[0-9,]+\s*개|\b[0-9,]+\s+comments?\b'):
        m = re.search(pattern, text)
        if m:
            stats.append(m.group(0))
    return ' / '.join(stats)


def _parse_article(html, url):
    soup = Soup(html)
    article = soup.find(id='post-article')
    if not article:
        raise LoginRequired()

    prose = _find_class(article, 'article-prose')
    content = _find_class(prose, 'tiptap')
    selector = '.tiptap' if content else '.ProseMirror'
    content = content or _find_class(article, 'ProseMirror')
    if not content:
        raise Exception('Kone article body was not found')

    header = article.find('header', recursive=False) or article
    media = []
    seen = set()
    _extract_media(content, url, media, seen)

    comments = _parse_comments(soup, url, media, seen)

    meta_time = soup.find('meta', {'property': 'article:published_time'})
    published = meta_time.get('content') if meta_time and meta_time.get('content') else ''
    visible_time = _first_text_matching(header, r'\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}')

    sub_handle, post_id = _split_post_url(url)

    parsed = {
        'url': url,
        'sub_handle': sub_handle,
        'post_id': post_id,
        'title': _find_title(header, soup),
        'category': _find_category(header, url),
        'writer': _find_writer(header),
        'published': published,
        'visible_time': visible_time,
        'stats': _find_stats(header),
        'content_html': _fragment_html(content, url, selector, inner=True),
        'comments': comments,
        'media': media,
    }
    return parsed


class KoneMedia:
    def __init__(self, info, referer):
        self.name = info['name']
        if not self.name or self.name in ('.', '..') or any(c in self.name for c in '/\\:'):
            raise ValueError('Kone output name must be a filename')
        self.referer = referer
        self._url = info.get('url')
        self._data = info.get('data')
        # A fresh staging name avoids Hitomi's existing-file checks on each run.
        self.filename = '__kone_{}{}'.format(uuid.uuid4().hex, os.path.splitext(self.name)[1])
        self.url = LazyUrl(referer, self.get, self, pp=self.pp, detect_local=False)

    def get(self, _=None):
        if self._data is not None:
            return BytesIO(self._data)
        return self._url

    def pp(self, filename):
        destination = os.path.join(os.path.dirname(filename), self.name)
        # Keep the previous file until the replacement has finished downloading.
        os.replace(filename, destination)
        return destination


class KoneMHTML(KoneMedia):

    def __init__(self, parsed, session):
        self.parsed = parsed
        self.session = session
        ext = 'mhtml' if ARCHIVE_AS_MHTML else 'html'
        KoneMedia.__init__(self, {
            'name': '{}.{}'.format(clean_title(parsed['archive_name']), ext),
        }, parsed.get('url') or KONE_ROOT)

    def _html(self, mhtml=False):
        p = self.parsed
        title = escape(p.get('title') or 'kone')
        url = escape(p.get('url') or '')
        base_url = escape(p.get('mhtml_base') or '') if mhtml else ''
        base_tag = '<base href="{}">\n'.format(base_url) if base_url else ''
        category = escape(p.get('category') or '')
        writer = escape(p.get('writer') or '')
        visible_time = escape(p.get('visible_time') or p.get('published') or '')
        stats = escape(p.get('stats') or '')

        comments_html = []
        for comment in p.get('comments') or []:
            margin = int(comment.get('depth') or 0) * 24
            user = escape(comment.get('user') or 'anonymous')
            user_url = escape(comment.get('user_url') or '')
            time_text = escape(comment.get('time') or '')
            body = comment.get('html') or ''
            if user_url:
                user_html = '<a href="{0}">{1}</a>'.format(user_url, user)
            else:
                user_html = user
            comments_html.append(
                '<article class="kone-comment" style="margin-left:{0}px">'
                '<div class="kone-comment-meta"><strong>{1}</strong><span>{2}</span></div>'
                '<div class="kone-comment-body">{3}</div>'
                '</article>'.format(margin, user_html, time_text, body)
            )

        meta_bits = []
        if category:
            meta_bits.append(category)
        if writer:
            meta_bits.append(writer)
        if visible_time:
            meta_bits.append(visible_time)
        if stats:
            meta_bits.append(stats)

        return '''<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{base_tag}<title>{title}</title>
<style>
:root {{
  color-scheme: dark;
  --bg: #0b0c10;
  --panel: #14161c;
  --panel-2: #1a1d24;
  --line: #2a2f38;
  --text: #e6e8ef;
  --muted: #a4a9b6;
  --link: #8ab4ff;
}}
* {{ box-sizing: border-box; }}
body {{
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  line-height: 1.62;
}}
a {{ color: var(--link); text-decoration: none; }}
a:hover {{ text-decoration: underline; }}
.kone-wrap {{ max-width: 980px; margin: 0 auto; padding: 28px 18px 56px; }}
.kone-head {{ border-bottom: 1px solid var(--line); padding-bottom: 18px; margin-bottom: 24px; }}
.kone-title {{ margin: 0 0 10px; font-size: 28px; line-height: 1.32; }}
.kone-meta, .kone-source {{ color: var(--muted); font-size: 13px; }}
.kone-meta span + span::before {{ content: " / "; color: #6f7683; }}
.kone-article {{
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 20px;
  overflow-wrap: anywhere;
}}
.kone-article img, .kone-comment-body img {{
  display: block;
  max-width: 100%;
  height: auto;
  margin: 14px auto;
  border-radius: 6px;
}}
.kone-article video, .kone-article audio,
.kone-comment-body video, .kone-comment-body audio {{
  display: block;
  width: 100%;
  max-width: 100%;
  margin: 14px 0;
}}
.kone-article p {{ margin: 0.85em 0; }}
.kone-sticker-skipped {{ color: var(--muted); font-size: 13px; }}
.kone-comments {{ margin-top: 28px; }}
.kone-comments h2 {{ font-size: 18px; margin: 0 0 12px; }}
.kone-comment {{
  background: var(--panel-2);
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 10px 12px;
  margin-top: 8px;
}}
.kone-comment-meta {{
  display: flex;
  gap: 10px;
  align-items: baseline;
  color: var(--muted);
  font-size: 12px;
  margin-bottom: 6px;
}}
.kone-comment-meta strong {{ color: var(--text); font-size: 13px; }}
.kone-comment-body {{ white-space: pre-wrap; overflow-wrap: anywhere; font-size: 14px; }}
blockquote {{
  margin: 1em 0;
  padding-left: 1em;
  border-left: 3px solid var(--line);
  color: var(--muted);
}}
pre, code {{
  background: #0f1117;
  border: 1px solid var(--line);
  border-radius: 6px;
}}
pre {{ padding: 12px; overflow-x: auto; }}
code {{ padding: 1px 4px; }}
table {{ max-width: 100%; border-collapse: collapse; }}
td, th {{ border: 1px solid var(--line); padding: 6px 8px; }}
</style>
</head>
<body>
<main class="kone-wrap">
  <header class="kone-head">
    <h1 class="kone-title">{title}</h1>
    <div class="kone-meta">{meta}</div>
    <div class="kone-source"><a href="{url}">{url}</a></div>
  </header>
  <section class="kone-article">{content}</section>
  <section class="kone-comments">
    <h2>Comments ({comment_count})</h2>
    {comments}
  </section>
</main>
</body>
</html>'''.format(
            title=title,
            url=url,
            base_tag=base_tag,
            meta=''.join('<span>{}</span>'.format(x) for x in meta_bits),
            content=p.get('content_html') or '',
            comment_count=len(p.get('comments') or []),
            comments='\n'.join(comments_html),
        )

    def _fetch_media(self, url):
        headers = {
            'Referer': self.parsed.get('url') or KONE_ROOT,
            'Accept': '*/*',
        }
        try:
            res = self.session.get(url, headers=headers, timeout=60)
        except TypeError:
            res = self.session.get(url, timeout=60)

        if hasattr(res, 'raise_for_status'):
            res.raise_for_status()

        data = getattr(res, 'content', None)
        if data is None:
            data = res
        if isinstance(data, str):
            data = data.encode('utf-8')

        headers_obj = getattr(res, 'headers', {}) or {}
        content_type = headers_obj.get('Content-Type') or headers_obj.get('content-type') or ''
        content_type = content_type.split(';', 1)[0].strip()
        if not content_type:
            content_type = mimetypes.guess_type(urlparse(url).path)[0] or 'application/octet-stream'

        return content_type, data

    @staticmethod
    def _b64(data):
        encoded = base64.b64encode(data).decode('ascii')
        return '\r\n'.join(encoded[i:i + 76] for i in range(0, len(encoded), 76))

    def _part(self, content_type, location, data):
        return (
            'Content-Type: {0}\r\n'
            'Content-Transfer-Encoding: base64\r\n'
            'Content-Location: {1}\r\n\r\n'
            '{2}\r\n'
        ).format(content_type, location, self._b64(data))

    def get(self, _=None):
        if not ARCHIVE_AS_MHTML:
            return BytesIO(self._html(False).encode('utf-8'))

        boundary = '----=_Kone_{0}'.format(uuid.uuid4().hex)
        html_data = self._html(True).encode('utf-8')
        base_url = self.parsed.get('mhtml_base') or (KONE_ROOT + '/')

        chunks = [
            'From: <Saved by Hitomi Downloader>\r\n',
            'Subject: {0}\r\n'.format(self.parsed.get('title') or 'kone'),
            'MIME-Version: 1.0\r\n',
            'Content-Type: multipart/related; type="text/html"; boundary="{0}"\r\n\r\n'.format(boundary),
            '--{0}\r\n'.format(boundary),
            self._part(
                'text/html; charset="utf-8"',
                base_url.rstrip('/') + '/index.html',
                html_data,
            ),
        ]

        for item in self.parsed.get('media') or []:
            url = item.get('url')
            if not _is_downloadable(url):
                continue
            try:
                if item.get('data') is not None:
                    content_type, data = item['content_type'], item['data']
                else:
                    content_type, data = self._fetch_media(url)
                chunks.append('--{0}\r\n'.format(boundary))
                chunks.append(self._part(
                    content_type,
                    base_url.rstrip('/') + '/' + (item.get('name') or url),
                    data,
                ))
            except Exception as e:
                downloader.print_('MHTML media skipped: {} ({})'.format(url, e))

        chunks.append('--{0}--\r\n'.format(boundary))
        return BytesIO(''.join(chunks).encode('utf-8'))


class Downloader_kone(Downloader):
    type = 'kone'
    URLS = URLS
    single = False
    strip_header = False
    # Do not reuse the previous run's resolved paths for unchanged media URLs.
    detect_local_lazy = False
    detect_removed = False
    ACCEPT_COOKIES = ACCEPT_COOKIES
    display_name = 'Kone.gg'
    icon = 'https://kone.gg/favicon.ico'

    def init(self):
        self.session = Session()
        self.session.headers.update({
            'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',
            'Accept-Language': 'ko-KR,ko;q=0.9,en-US;q=0.8,en;q=0.7',
            'Cache-Control': 'no-cache',
            'Pragma': 'no-cache',
            'Referer': KONE_ROOT + '/',
            'User-Agent': downloader.hdr.get('User-Agent', 'Mozilla/5.0'),
        })

    def _read_html(self):
        try:
            html = clf2.solve(self.url, session=self.session)
            if isinstance(html, dict):
                html = html.get('html') or html.get('data') or ''
        except Exception:
            res = self.session.get(self.url, timeout=60)
            if hasattr(res, 'raise_for_status'):
                res.raise_for_status()
            html = getattr(res, 'text', None)
            if html is None:
                content = getattr(res, 'content', res)
                html = content.decode('utf-8', 'replace') if isinstance(content, bytes) else str(content)

        return _fix_mojibake(html)

    def read(self):
        self.url = _abs_url(KONE_ROOT, self.url)
        _split_post_url(self.url)

        html = self._read_html()
        parsed = _parse_article(html, self.url)
        parsed = _prepare_stickers(parsed)

        title = parsed['title'] or parsed['post_id']
        category = parsed.get('category') or ''
        if INCLUDE_CATEGORY_IN_TITLE and category and category not in title:
            archive_name = '[{0}] {1}_{2}'.format(category, title, parsed['post_id'])
        else:
            archive_name = '{0}_{1}'.format(title, parsed['post_id'])
        parsed['archive_name'] = clean_title(archive_name)
        parsed = _apply_local_media_paths(parsed)

        self.title = parsed['archive_name']
        self.urls = []

        for item in parsed.get('media') or []:
            self.urls.append(KoneMedia(item, self.url).url)

        self.urls.append(KoneMHTML(parsed, self.session).url)

        downloader.print_('Kone: downloading fresh copies; replacing files after successful downloads')
        downloader.print_('Kone media: {}'.format(len(parsed.get('media') or [])))
        downloader.print_('Kone comments: {}'.format(len(parsed.get('comments') or [])))


try:
    messageBox('{}: kone.gg'.format(tr_('Site added')))
except Exception:
    pass
